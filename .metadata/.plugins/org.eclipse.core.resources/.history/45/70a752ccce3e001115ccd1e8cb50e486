package com.collection.set.demo;

import java.util.TreeSet;

public class TreesetDemo {
	public static void main(String[] args) {
		//Provides data in Sorted Format
		TreeSet t1=new TreeSet();
		t1.add(34);
		t1.add(20);
		t1.add(10);
		t1.add(80);
		t1.add(24);
		t1.add(76);
		
		System.out.println(t1);
		
		TreeSet<TresetDemoStudent> s1=new TreeSet<TresetDemoStudent>();
		TresetDemoStudent St1=new TresetDemoStudent(101, "asdf", "sdfg", 2000);
		TresetDemoStudent St2=new TresetDemoStudent(101, "sdf", "sfg", 2000);
		TresetDemoStudent St3=new TresetDemoStudent(101, "oiuy", "mn", 2000);
		TresetDemoStudent St4=new TresetDemoStudent(101, "uy", "mnbv", 2000);
		s1.add(St1);
		s1.add(St2);
		s1.add(St3);
		s1.add(St4);
		System.out.println(s1);
		
	}
}
