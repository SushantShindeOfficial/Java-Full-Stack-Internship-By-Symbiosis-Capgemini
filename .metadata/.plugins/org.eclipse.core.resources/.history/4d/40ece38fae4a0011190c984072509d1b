package com.mapping.demo;

import java.util.List;

public class College {
	private int regNo;
    private String name;
    private University u;
    private List<Dept> depts;

    
    public College() {
		super();
		// TODO Auto-generated constructor stub
	}

	public College(int regNo, String name, University u, List<Dept> depts, Principal principal) {
		super();
		this.regNo = regNo;
		this.name = name;
		this.u = u;
		this.depts = depts;
		this.principal = principal;
	}

//	@Override
