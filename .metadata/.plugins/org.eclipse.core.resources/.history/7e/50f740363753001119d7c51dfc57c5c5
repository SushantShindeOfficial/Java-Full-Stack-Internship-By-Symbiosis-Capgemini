package hibernate.demo.jpql.task.test;

import java.util.List;

import javax.persistence.EntityManager;
import javax.persistence.Query;

import hibernate.demo.jpql.task.dbconnection.DbConnection;

public class Test {
	public static void main(String[] args) {
		EntityManager em = DbConnection.dbCon().createEntityManager();
		em.getTransaction().begin();

		String sql = "SELECT c.cname, s.sname FROM course c LEFT JOIN student_course sc " +
				"ON c.cid = sc.course_id LEFT JOIN student s ON s.sid = sc.student_id  UNION " +
				"SELECT c.cname, s.sname FROM course c RIGHT JOIN student_course sc " +
				"ON c.cid = sc.course_id RIGHT JOIN student s ON s.sid = sc.student_id";
		
		Query q1 = em.createNativeQuery(sql);

		List<Object[]> list = q1.getResultList();

		for(Object[] obj : list) {

			System.out.println( obj[0] + " " +obj[1]);
		}

		em.getTransaction().commit();
	}

}
