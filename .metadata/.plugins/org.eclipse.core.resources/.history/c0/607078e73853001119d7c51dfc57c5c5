package hibernate.demo.jpql.task.test;

import java.util.List;

import javax.persistence.EntityManager;
import javax.persistence.Query;

import hibernate.demo.jpql.task.dbconnection.DbConnection;

public class TestDemo {
	public static void main(String[] args) {
		EntityManager em = DbConnection.dbCon().createEntityManager();
		em.getTransaction().begin();

		String jpql = "select c.cname, count(s.sid) " +
				"from Course c join c.students s " +
				"group by c.cname";

		Query q1 = em.createQuery( jpql);

		List<Object[]> list = q1.getResultList();

		for(Object[] obj : list) {

			System.out.println(
					obj[0] + " " +
							obj[1]
					);
		}


		em.getTransaction().commit();
	}

}
