package springboot.springboot.homework.demo;

/**
 * Hello world!
 *
 */
public class App {
	public static void main(String[] args) {
		ApplicationContext applicationContext = new ClassPathXmlApplicationContext("applicationContext.xml");

		// Principal Bean
		Principal p1 = (Principal) applicationContext.getBean("principal1");

		System.out.println(p1.getId());
		System.out.println(p1.getName());
		System.out.println(p1.getCity());
		System.out.println(p1.getSalary());

		// College Details
		College c1 = p1.getCollege();

		System.out.println(c1.getId());
		System.out.println(c1.getName());
		System.out.println(c1.getCity());

		// Department Details
		Dept d1 = c1.getDepts().get(0);

		System.out.println(d1.getId());
		System.out.println(d1.getName());
		System.out.println(d1.getBuilding());

		// Teacher Details
		Teacher t1 = d1.getTeachers().get(0);

		System.out.println(t1.getId());
		System.out.println(t1.getName());
		System.out.println(t1.getCity());
		System.out.println(t1.getSalary());
		System.out.println(t1.getSubjects());

		// Student Details
		Student s1 = d1.getStudents().get(0);

		System.out.println(s1.getId());
		System.out.println(s1.getName());
		System.out.println(s1.getCity());
		System.out.println(s1.getPer());
	}
}
