package springboot.springboot.homework.demo.entity2;

import java.util.List;

public class Districts {
	private int id;
	private String name;

	private List<Taluka> talukas;

	public Districts() {
		super();
		// TODO Auto-generated constructor stub
	}

	public Districts(int id, String name, List<Taluka> talukas) {
		super();
		this.id = id;
		this.name = name;
		this.talukas = talukas;
	}

	@Override
	public String toString() {
		return "Districts [id=" + id + ", name=" + name + ", talukas=" + talukas + "]";
	}

	public int getId() {
		return id;
	}

	public void setId(int id) {
		this.id = id;
	}

	public String getName() {
		return name;
	}

	public void setName(String name) {
		this.name = name;
	}

	public List<Taluka> getTalukas() {
		return talukas;
	}

	public void setTalukas(List<Taluka> talukas) {
		this.talukas = talukas;
	}

}
