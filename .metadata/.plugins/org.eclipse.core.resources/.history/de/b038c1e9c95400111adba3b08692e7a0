package springboot.springboot.demo3;

import org.springframework.context.ApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;

import springboot.springboot.demo3.entity.Employee;

/**
 * Hello world!
 *
 */
public class App {
	public static void main(String[] args) {

		ApplicationContext applicationContext = new ClassPathXmlApplicationContext("applicationContext.xml");

		// Constructor Injection Bean
		Employee e1 = (Employee) applicationContext.getBean("emp");

		System.out.println("===== Constructor Injection =====");
		System.out.println(e1.getEmployeeId());
		System.out.println(e1.getFullName());
		System.out.println(e1.getAadharNumber());
		System.out.println(e1.getPanNumber());
		System.out.println(e1.getEmail());
		System.out.println(e1.getMobileNumber());
		System.out.println(e1.getDateOfBirth());
		System.out.println(e1.getJoiningDate());
		System.out.println(e1.getExperience());
		System.out.println(e1.getSalary());

		// Setter Injection Bean
		Employee e2 = (Employee) applicationContext.getBean("emp1");

		System.out.println("\n===== Setter Injection =====");
		System.out.println(e2.getEmployeeId());
		System.out.println(e2.getFullName());
		System.out.println(e2.getAadharNumber());
		System.out.println(e2.getPanNumber());
		System.out.println(e2.getEmail());
		System.out.println(e2.getMobileNumber());
		System.out.println(e2.getDateOfBirth());
		System.out.println(e2.getJoiningDate());
		System.out.println(e2.getExperience());
		System.out.println(e2.getSalary());
	}
}
